{{ 'password-coming-soon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'password-coming-soon.js' | asset_url }}" defer></script>

{% liquid
  assign overlay_decimal = section.settings.overlay_opacity | divided_by: 100.0
%}

<section
  class="wp-password-page"
  style="
    --overlay-opacity: {{ overlay_decimal }};
    --bg-color: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --muted-color: {{ section.settings.muted_color }};
    --button-bg: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text_color }};
    --button-hover-bg: {{ section.settings.button_hover_bg }};
    --input-bg: {{ section.settings.input_bg }};
    --input-border: {{ section.settings.input_border }};
    --radius: {{ section.settings.border_radius }}px;
    --container-width: {{ section.settings.container_width }}px;
  "
>
  <div class="wp-password-page__background">
    {% if section.settings.desktop_background != blank %}
      <div class="wp-password-page__bg-image wp-password-page__bg-image--desktop" style="background-image:url('{{ section.settings.desktop_background | image_url: width: 2400 }}');"></div>
    {% endif %}

    {% if section.settings.mobile_background != blank %}
      <div class="wp-password-page__bg-image wp-password-page__bg-image--mobile" style="background-image:url('{{ section.settings.mobile_background | image_url: width: 1200 }}');"></div>
    {% endif %}
  </div>

  <div class="wp-password-page__overlay"></div>

  <main class="wp-password-page__inner">
    <div class="wp-password-page__content">

      {% if section.settings.logo != blank %}
        <img class="wp-password-page__logo" src="{{ section.settings.logo | image_url: width: 700 }}" alt="{{ shop.name | escape }}" loading="lazy">
      {% else %}
        <div class="wp-password-page__brand">{{ shop.name }}</div>
      {% endif %}

      {% if section.settings.enable_countdown %}
        <div class="wp-password-page__countdown" data-wp-countdown data-launch-date="{{ section.settings.launch_date | escape }}">
          <div class="wp-password-page__count-item"><span data-days>00</span><small>DAYS</small></div>
          <span class="wp-password-page__colon">:</span>
          <div class="wp-password-page__count-item"><span data-hours>00</span><small>HRS</small></div>
          <span class="wp-password-page__colon">:</span>
          <div class="wp-password-page__count-item"><span data-minutes>00</span><small>MIN</small></div>
          <span class="wp-password-page__colon">:</span>
          <div class="wp-password-page__count-item"><span data-seconds>00</span><small>SEC</small></div>
        </div>

        <div class="wp-password-page__live" data-wp-live hidden>
          {{ section.settings.live_text }}
        </div>
      {% endif %}

      <h1 class="wp-password-page__heading">{{ section.settings.heading }}</h1>

      {% if section.settings.subheading != blank %}
        <p class="wp-password-page__subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      <form
        class="wp-password-page__form"
        data-wp-signup-form
        data-klaviyo-public-key="{{ section.settings.klaviyo_public_key }}"
        data-klaviyo-list-id="{{ section.settings.klaviyo_list_id }}"
      >
        <div class="wp-password-page__fields" data-wp-fields>
          <input type="email" name="email" placeholder="{{ section.settings.email_placeholder }}" autocomplete="email" required>

          {% if section.settings.enable_phone %}
            <input type="tel" name="phone" placeholder="{{ section.settings.phone_placeholder }}" autocomplete="tel" {% if section.settings.phone_required %}required{% endif %}>
          {% endif %}

          {% if section.settings.enable_sms_consent %}
            <label class="wp-password-page__consent">
              <input type="checkbox" required>
              <span>{{ section.settings.sms_consent_text }}</span>
            </label>
          {% endif %}
        </div>

        <button class="wp-password-page__button" type="submit" data-wp-submit-button>
          {{ section.settings.button_text }}
        </button>

        <div class="wp-password-page__message" data-wp-message aria-live="polite"></div>
      </form>

      {% if section.settings.enable_links %}
        <div class="wp-password-page__links">
          {% if section.settings.privacy_url != blank %}
            <a href="{{ section.settings.privacy_url }}">Privacy Policy</a>
          {% endif %}
          {% if section.settings.terms_url != blank %}
            <a href="{{ section.settings.terms_url }}">Terms</a>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.enable_password_login %}
        <button class="wp-password-page__password-toggle" type="button" data-wp-password-toggle>
          {{ section.settings.password_button_text }}
        </button>

        <div class="wp-password-page__password-panel" data-wp-password-panel hidden>
          {% form 'storefront_password', class: 'wp-password-page__password-form' %}
            <input type="password" name="password" placeholder="Enter password" autocomplete="current-password" required>
            <button type="submit">Enter</button>

            {% if form.errors %}
              <div class="wp-password-page__error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}

      {% if section.settings.footer_text != blank %}
        <div class="wp-password-page__footer">{{ section.settings.footer_text }}</div>
      {% endif %}

    </div>
  </main>
</section>

{% schema %}
{
  "name": "WP Coming Soon",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "desktop_background", "label": "Desktop background image" },
    { "type": "image_picker", "id": "mobile_background", "label": "Mobile background image" },

    { "type": "text", "id": "klaviyo_public_key", "label": "Klaviyo Public Key / Site ID", "default": "Y7tdFJ" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo List ID", "default": "UTdr5F" },

    { "type": "color", "id": "background_color", "label": "Fallback background color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Dark overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },

    { "type": "text", "id": "launch_date", "label": "Launch date/time", "default": "2026-12-31T00:00:00", "info": "Format: YYYY-MM-DDTHH:MM:SS" },
    { "type": "checkbox", "id": "enable_countdown", "label": "Enable countdown", "default": true },
    { "type": "text", "id": "live_text", "label": "Live text", "default": "WE ARE LIVE" },

    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Early Access & 10% Off\nYour Next Order" },
    { "type": "textarea", "id": "subheading", "label": "Small text", "default": "Sign up for early access." },

    { "type": "text", "id": "button_text", "label": "CTA button text", "default": "Send Text" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Email Address" },

    { "type": "checkbox", "id": "enable_phone", "label": "Enable phone field", "default": true },
    { "type": "checkbox", "id": "phone_required", "label": "Phone required", "default": true },
    { "type": "text", "id": "phone_placeholder", "label": "Phone placeholder", "default": "Phone Number e.g. +923001234567" },

    { "type": "checkbox", "id": "enable_sms_consent", "label": "Enable SMS consent", "default": true },
    {
      "type": "textarea",
      "id": "sms_consent_text",
      "label": "SMS consent text",
      "default": "I agree to receive recurring automated marketing text messages. Consent is not a condition of purchase. Msg & data rates may apply."
    },

    { "type": "checkbox", "id": "enable_links", "label": "Enable Privacy / Terms links", "default": true },
    { "type": "url", "id": "privacy_url", "label": "Privacy Policy URL" },
    { "type": "url", "id": "terms_url", "label": "Terms URL" },

    { "type": "checkbox", "id": "enable_password_login", "label": "Enable password login", "default": true },
    { "type": "text", "id": "password_button_text", "label": "Password button text", "default": "Password?" },

    { "type": "text", "id": "footer_text", "label": "Footer text", "default": "Rewards" },

    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "muted_color", "label": "Muted text color", "default": "#c9c9c9" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#4a4a4a" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#666666" },
    { "type": "color", "id": "input_bg", "label": "Input background", "default": "#111111" },
    { "type": "color", "id": "input_border", "label": "Input border", "default": "#333333" },

    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "container_width", "label": "Container width", "min": 320, "max": 760, "step": 20, "unit": "px", "default": 620 }
  ],
  "presets": [
    { "name": "WP Coming Soon" }
  ]
}
{% endschema %}