{{ 'password-coming-soon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'password-coming-soon.js' | asset_url }}" defer></script>

{% liquid
  assign overlay_decimal = section.settings.overlay_opacity | divided_by: 100.0
%}

<section
  class="wp-password-page"
  style="
    --overlay-opacity: {{ overlay_decimal }};
    --bg-color: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --muted-color: {{ section.settings.muted_color }};
    --button-bg: {{ section.settings.button_bg }};
    --button-text: {{ section.settings.button_text_color }};
    --button-hover-bg: {{ section.settings.button_hover_bg }};
    --input-bg: {{ section.settings.input_bg }};
    --input-border: {{ section.settings.input_border }};
    --radius: {{ section.settings.border_radius }}px;
    --container-width: {{ section.settings.container_width }}px;
  "
>
  <div class="wp-password-page__shell">
    <header class="wp-password-page__brand" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        <img
          class="wp-password-page__logo"
          src="{{ section.settings.logo | image_url: width: 900 }}"
          alt="{{ shop.name | escape }}"
          loading="eager"
        >
      {% else %}
        <span class="wp-password-page__brand-text">{{ shop.name | escape }}</span>
      {% endif %}
    </header>

    <div class="wp-password-page__intro">
      <h1 class="wp-password-page__tagline">{{ section.settings.heading }}</h1>
      <span class="wp-password-page__rule" aria-hidden="true"></span>
      <p class="wp-password-page__subheading">{{ section.settings.subheading }}</p>
    </div>

    {% if section.settings.enable_countdown %}
      <div class="wp-password-page__countdown" data-wp-countdown data-launch-date="{{ section.settings.launch_date | escape }}">
        <div class="wp-password-page__count-item">
          <span data-days>00</span>
          <small>DAYS</small>
        </div>
        <div class="wp-password-page__count-divider" aria-hidden="true"></div>
        <div class="wp-password-page__count-item">
          <span data-hours>00</span>
          <small>HOURS</small>
        </div>
        <div class="wp-password-page__count-divider" aria-hidden="true"></div>
        <div class="wp-password-page__count-item">
          <span data-minutes>00</span>
          <small>MINUTES</small>
        </div>
        <div class="wp-password-page__count-divider" aria-hidden="true"></div>
        <div class="wp-password-page__count-item">
          <span data-seconds>00</span>
          <small>SECONDS</small>
        </div>
      </div>

      <div class="wp-password-page__live" data-wp-live hidden>
        {{ section.settings.live_text }}
      </div>
    {% endif %}

    <form
      class="wp-password-page__form"
      data-wp-signup-form
      data-klaviyo-public-key="{{ section.settings.klaviyo_public_key }}"
      data-klaviyo-list-id="{{ section.settings.klaviyo_list_id }}"
    >
      <div class="wp-password-page__primary-row">
        <div class="wp-password-page__field">
          <label class="visually-hidden" for="ComingSoonEmail">Email address</label>
          <input
            id="ComingSoonEmail"
            type="email"
            name="email"
            placeholder="{{ section.settings.email_placeholder }}"
            autocomplete="email"
            required
          >
        </div>
        <button class="wp-password-page__button" type="submit" data-wp-submit-button>
          {{ section.settings.button_text }}
        </button>
      </div>

      {% if section.settings.enable_phone or section.settings.enable_sms_consent %}
        <div class="wp-password-page__secondary-fields" data-wp-fields>
          {% if section.settings.enable_phone %}
            <div class="wp-password-page__field">
              <label class="visually-hidden" for="ComingSoonPhone">Phone number</label>
              <input
                id="ComingSoonPhone"
                type="tel"
                name="phone"
                placeholder="{{ section.settings.phone_placeholder }}"
                autocomplete="tel"
                {% if section.settings.phone_required %}required{% endif %}
              >
            </div>
          {% endif %}

          {% if section.settings.enable_sms_consent %}
            <label class="wp-password-page__consent">
              <input id="ComingSoonConsent" type="checkbox" required>
              <span>{{ section.settings.sms_consent_text }}</span>
            </label>
          {% endif %}
        </div>
      {% endif %}

      <div class="wp-password-page__message" data-wp-message aria-live="polite"></div>
    </form>

    {% if section.settings.enable_contact_row %}
      <div class="wp-password-page__contact-row">
        {% if section.settings.contact_email != blank %}
          <a class="wp-password-page__contact-link" href="mailto:{{ section.settings.contact_email | escape }}">
            <span class="wp-password-page__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
                <path d="M4 7l8 6 8-6"></path>
              </svg>
            </span>
            <span>{{ section.settings.contact_email }}</span>
          </a>
        {% endif %}

        {% if section.settings.contact_phone != blank %}
          <a class="wp-password-page__contact-link" href="tel:{{ section.settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">
            <span class="wp-password-page__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M22 16.9v2.7a1.8 1.8 0 0 1-2 1.8c-3.2-.5-6.1-1.8-8.6-4.3S6 12.8 5.5 9.6A1.8 1.8 0 0 1 7.3 7.6H10l1.6 3.2-1.6 1.6c1.2 2.2 2.9 3.9 5.1 5.1l1.6-1.6 3.3 1z"></path>
              </svg>
            </span>
            <span>{{ section.settings.contact_phone }}</span>
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.enable_password_login %}
      <div class="wp-password-page__password-access">
        <button class="wp-password-page__password-toggle" type="button" data-wp-password-toggle>
          {{ section.settings.password_button_text }}
        </button>

        <div class="wp-password-page__password-panel" data-wp-password-panel hidden>
          {% form 'storefront_password', class: 'wp-password-page__password-form' %}
            <label class="visually-hidden" for="Password">Password</label>
            <input
              id="Password"
              type="password"
              name="password"
              placeholder="Enter password"
              autocomplete="current-password"
              required
            >
            <button type="submit">
              {{ section.settings.password_submit_text }}
            </button>

            {% if form.errors %}
              <div class="wp-password-page__error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
          {% endform %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "WP Coming Soon",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "klaviyo_public_key", "label": "Klaviyo Public Key / Site ID", "default": "Y7tdFJ" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo List ID", "default": "UTdr5F" },

    { "type": "color", "id": "background_color", "label": "Fallback background color", "default": "#ffffff" },
    { "type": "range", "id": "overlay_opacity", "label": "Dark overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },

    { "type": "text", "id": "launch_date", "label": "Launch date/time", "default": "2026-07-24T00:00:00", "info": "Format: YYYY-MM-DDTHH:MM:SS" },
    { "type": "checkbox", "id": "enable_countdown", "label": "Enable countdown", "default": true },
    { "type": "text", "id": "live_text", "label": "Live text", "default": "WE ARE LIVE" },

    { "type": "textarea", "id": "heading", "label": "Heading", "default": "SOMETHING IS COMING." },
    { "type": "textarea", "id": "subheading", "label": "Small text", "default": "BE THE FIRST TO KNOW." },

    { "type": "text", "id": "button_text", "label": "CTA button text", "default": "NOTIFY ME" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "ENTER YOUR EMAIL" },

    { "type": "checkbox", "id": "enable_phone", "label": "Enable phone field", "default": true },
    { "type": "checkbox", "id": "phone_required", "label": "Phone required", "default": true },
    { "type": "text", "id": "phone_placeholder", "label": "Phone placeholder", "default": "+1 (123) 456-7890" },

    { "type": "checkbox", "id": "enable_sms_consent", "label": "Enable SMS consent", "default": true },
    {
      "type": "textarea",
      "id": "sms_consent_text",
      "label": "SMS consent text",
      "default": "I agree to receive recurring automated marketing text messages. Consent is not a condition of purchase. Msg & data rates may apply."
    },

    { "type": "checkbox", "id": "enable_contact_row", "label": "Enable contact row", "default": true },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "hello@moment.com" },
    { "type": "text", "id": "contact_phone", "label": "Contact phone", "default": "+1 (123) 456-7890" },

    { "type": "checkbox", "id": "enable_password_login", "label": "Enable password login", "default": true },
    { "type": "text", "id": "password_button_text", "label": "Password button text", "default": "ENTER PASSWORD" },
    { "type": "text", "id": "password_submit_text", "label": "Password submit text", "default": "ENTER" },

    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "muted_color", "label": "Muted text color", "default": "#555555" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#111111" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#2b2b2b" },
    { "type": "color", "id": "input_bg", "label": "Input background", "default": "#ffffff" },
    { "type": "color", "id": "input_border", "label": "Input border", "default": "#111111" },

    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "container_width", "label": "Container width", "min": 320, "max": 760, "step": 20, "unit": "px", "default": 720 }
  ],
  "presets": [
    { "name": "WP Coming Soon" }
  ]
}
{% endschema %}
