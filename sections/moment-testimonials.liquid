{{ 'moment.css' | asset_url | stylesheet_tag }}

<section class="moment-testimonials" {{ section.shopify_attributes }}>
  <div class="moment-testimonials__inner">
    <div class="moment-testimonials__brand">
      {{ section.settings.brand }}
    </div>

    <div class="moment-testimonials__main">
      <h2 class="moment-testimonials__title">{{ section.settings.title }}</h2>

      <div class="moment-testimonials__meta">
        {%- for block in section.blocks -%}
          <div class="moment-testimonials__meta-item" {{ block.shopify_attributes }}>
            <p class="moment-testimonials__label">{{ block.settings.label }}</p>
            <div class="moment-testimonials__value">{{ block.settings.value }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="moment-testimonials__action">
        <a
          class="moment-testimonials__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Moment Collection Info",
  "tag": "section",
  "class": "section section-moment-testimonials",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Brand text",
      "default": "MOMENT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Collection 1"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "meta",
      "name": "Detail",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Price"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "$260 USD"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Moment Collection Info",
      "blocks": [
        {
          "type": "meta",
          "settings": {
            "label": "Price",
            "value": "$260 USD"
          }
        },
        {
          "type": "meta",
          "settings": {
            "label": "Pieces",
            "value": "Nine essentials"
          }
        },
        {
          "type": "meta",
          "settings": {
            "label": "Season",
            "value": "Spring / Summer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
