{{ 'moment.css' | asset_url | stylesheet_tag }}
{{ 'moment-home-popup.css' | asset_url | stylesheet_tag }}

<script src="{{ 'klaviyo-subscribe.js' | asset_url }}" defer></script>
<script src="{{ 'moment-home-popup.js' | asset_url }}" defer></script>

{%- liquid
  assign hero_image = section.settings.hero_image
-%}

<section class="moment-hero" {{ section.shopify_attributes }}>
  <div class="moment-hero__media">
    {%- if hero_image != blank -%}
      {{
        hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'moment-hero__image',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      <div class="moment-hero__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'moment-hero__placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  {%- if request.page_type == 'index' -%}
    <div class="moment-home-popup" data-home-popup hidden>
      <div class="moment-home-popup__backdrop" data-home-popup-close></div>
      <div
        class="moment-home-popup__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="MomentHomePopupTitle"
      >
        <button
          class="moment-home-popup__close"
          type="button"
          aria-label="Close subscription popup"
          data-home-popup-close
        >
          <span aria-hidden="true">X</span>
        </button>

        <div class="moment-home-popup__content">
          <h2 id="MomentHomePopupTitle" class="moment-home-popup__heading">Subscribe for Exclusive Benefits</h2>
          <p class="moment-home-popup__subheading">Join the list to get early access, updates, and subscriber-only benefits.</p>

          <form
            class="wp-password-page__form moment-home-popup__form"
            data-wp-signup-form
            data-klaviyo-public-key="{{ section.settings.klaviyo_public_key }}"
            data-klaviyo-list-id="{{ section.settings.klaviyo_list_id }}"
            data-klaviyo-phone-list-id="{{ section.settings.klaviyo_phone_list_id }}"
            data-klaviyo-custom-source="Shopify Homepage Popup"
            data-klaviyo-source-label="Homepage Popup"
          >
            <div class="wp-password-page__fields moment-home-popup__fields" data-wp-fields>
              <input type="email" name="email" placeholder="Email Address" autocomplete="email" required>
              <input type="tel" name="phone" placeholder="Phone Number e.g. +12125551234" autocomplete="tel" required>

              <label class="wp-password-page__consent moment-home-popup__consent">
                <input type="checkbox" required>
                <span>I agree to receive recurring automated marketing text messages. Consent is not a condition of purchase. Msg & data rates may apply.</span>
              </label>
            </div>

            <button class="wp-password-page__button moment-home-popup__button" type="submit" data-wp-submit-button>
              Subscribe Now
            </button>

            <button class="moment-home-popup__dismiss" type="button" data-home-popup-close>
              Close Popup
            </button>

            <div class="wp-password-page__message" data-wp-message aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Moment Hero",
  "tag": "section",
  "class": "section section-moment-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "klaviyo_public_key",
      "label": "Klaviyo Public Key / Site ID",
      "default": "Y7tdFJ"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "Klaviyo Email List ID (e.g. Moment.wrld)",
      "default": "Xrb3Xf",
      "info": "Email signups are added to this list."
    },
    {
      "type": "text",
      "id": "klaviyo_phone_list_id",
      "label": "Klaviyo Phone/SMS List ID (optional, e.g. Moment.wrld)",
      "info": "Optional. If set, phone number signups are added to this separate list instead of the email list above. Leave blank to keep email and phone together in the list above."
    }
  ],
  "presets": [
    {
      "name": "Moment Hero"
    }
  ]
}
{% endschema %}
