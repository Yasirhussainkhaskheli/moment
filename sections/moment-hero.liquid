{{ 'moment.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.hero_image
-%}

<section class="moment-hero" {{ section.shopify_attributes }}>
  <div class="moment-hero__media">
    {%- if hero_image != blank -%}
      {{
        hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'moment-hero__image',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      <div class="moment-hero__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'moment-hero__placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Moment Hero",
  "tag": "section",
  "class": "section section-moment-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Moment Hero"
    }
  ]
}
{% endschema %}
