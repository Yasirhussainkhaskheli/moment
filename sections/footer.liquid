{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign about_url = '/about'
  assign contact_url = '/contact'
-%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="footer__content-top page-width">
    <div class="moment-footer">
      <div class="moment-footer__column moment-footer__column--brand">
        <a class="moment-footer__logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {%- if settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: settings.logo_width | image_tag:
                widths: '120, 180, 240, 320, 420',
                width: settings.logo_width,
                loading: 'lazy',
                class: 'moment-footer__logo',
                alt: shop.name
            }}
          {%- else -%}
            <span class="moment-footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.about_text != blank -%}
          <div class="moment-footer__about rte">
            {{ section.settings.about_text }}
          </div>
        {%- endif -%}
      </div>

      <div class="moment-footer__column">
        <p class="moment-footer__eyebrow">{{ section.settings.navigation_heading }}</p>
        <ul class="moment-footer__nav moment-footer__nav--shop list-unstyled" role="list">
          <li>
            <a class="moment-footer__link" href="{{ routes.all_products_collection_url }}">
              {{ section.settings.shop_label }}
            </a>
          </li>
          <li>
            <a class="moment-footer__link" href="{{ about_url }}">
              {{ section.settings.about_label }}
            </a>
          </li>
          <li>
            <a class="moment-footer__link" href="{{ contact_url }}">
              {{ section.settings.contact_label }}
            </a>
          </li>
        </ul>
      </div>

      <div class="moment-footer__column">
        <p class="moment-footer__eyebrow">{{ section.settings.legal_heading }}</p>
        <ul class="moment-footer__nav list-unstyled" role="list">
          <li>
            <a class="moment-footer__link" href="/pages/shipping-policy">Shipping policy</a>
          </li>
          <li>
            <a class="moment-footer__link" href="/pages/returns-refunds-policy">Returns &amp; Refunds Policy</a>
          </li>
          <li>
            <a class="moment-footer__link" href="/policies/terms-of-service">Terms of Service</a>
          </li>
          <li>
            <a class="moment-footer__link" href="/policies/privacy-policy">Privacy Policy</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__content-bottom">
    <div class="footer__content-bottom-wrapper page-width footer__content-bottom-wrapper--center">
      <div class="footer__copyright caption">
        <small class="copyright__content">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</small>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 160
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About text",
      "default": "<p>Thoughtfully curated essentials for everyday wear.</p><p>Designed to feel effortless in every moment.</p>"
    },
    {
      "type": "text",
      "id": "navigation_heading",
      "label": "Second column heading",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "About label",
      "default": "About"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About link"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact label",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    },
    {
      "type": "text",
      "id": "legal_heading",
      "label": "Third column heading",
      "default": "Info"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "Show shop policy pages"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
