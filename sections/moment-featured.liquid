{{ 'moment.css' | asset_url | stylesheet_tag }}
<script src="{{ 'moment.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign featured_collection = section.settings.collection

  if featured_collection == blank
    assign featured_collection = collections['all']
  endif
-%}

<section class="moment-featured" {{ section.shopify_attributes }}>
  <div class="moment-featured__inner">
    <div class="moment-featured__grid">
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        {%- assign sorted_products = featured_collection.products | sort: 'published_at' | reverse -%}
        {%- for product in sorted_products limit: section.settings.products_to_show -%}
          {%- assign gallery_images = product.images | slice: 0, 4 -%}
          <article class="moment-featured__card">
            <a class="moment-featured__link" href="{{ product.url }}">
              <div class="moment-featured__image-wrap">
                {%- if product.featured_image != blank -%}
                  <div
                    class="moment-featured__gallery{% if gallery_images.size > 1 %} moment-featured__gallery--hover-slideshow{% endif %}"
                    {% if gallery_images.size > 1 %}
                      data-hover-gallery
                      data-gallery-interval="850"
                    {% endif %}
                  >
                    {%- for image in gallery_images -%}
                      {%- capture image_class -%}moment-featured__image{% if forloop.first %} is-active{% endif %}{%- endcapture -%}
                      {{
                        image
                        | image_url: width: 900
                        | image_tag:
                          class: image_class,
                          widths: '300, 450, 600, 900',
                          sizes: '(min-width: 990px) 33vw, 50vw'
                      }}
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="moment-featured__placeholder">
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'moment-featured__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              <div class="moment-featured__meta">
                <h3 class="moment-featured__product-title">{{ product.title }}</h3>
                <div class="moment-featured__price">
                  {% render 'price', product: product, price_class: 'price--compact' %}
                </div>
              </div>
            </a>
          </article>
        {%- endfor -%}
      {%- else -%}
        <div class="moment-featured__empty">
          Add products to the selected collection to show them here.
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Moment Featured Products",
  "tag": "section",
  "class": "section section-moment-featured",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 9,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show view all link"
    }
  ],
  "presets": [
    {
      "name": "Moment Featured Products"
    }
  ]
}
{% endschema %}
