{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_path = request.path | downcase
  assign normalized_path = current_path | replace: '/pages/', '' | replace: '/', ''
  assign normalized_handle = page.handle | default: normalized_path | downcase
  assign normalized_title = page.title | handleize

  assign is_about_page = false
  if normalized_handle == 'about' or normalized_handle == 'about-us' or normalized_title == 'about' or normalized_title == 'about-us'
    assign is_about_page = true
  endif

  assign is_contact_page = false
  if normalized_handle == 'contact' or normalized_handle == 'contact-us' or normalized_title == 'contact' or normalized_title == 'contact-us'
    assign is_contact_page = true
  endif

  assign is_shipping_page = false
  if normalized_handle == 'shipping-policy' or normalized_title == 'shipping-policy'
    assign is_shipping_page = true
  endif

  assign is_returns_page = false
  if normalized_handle == 'returns-refunds-policy' or normalized_title == 'returns-refunds-policy'
    assign is_returns_page = true
  endif

  assign is_terms_page = false
  if normalized_handle == 'terms-of-service' or normalized_title == 'terms-of-service'
    assign is_terms_page = true
  endif

  assign is_privacy_page = false
  if normalized_handle == 'privacy-policy' or normalized_title == 'privacy-policy'
    assign is_privacy_page = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-signature {
    margin-top: 2.4rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2.4rem;
    line-height: 1;
    color: #111111;
  }

  .section-{{ section.id }}-about,
  .section-{{ section.id }}-contact-copy,
  .section-{{ section.id }}-policy {
    font-family: Arial, sans-serif;
    font-size: 1.55rem;
    line-height: 1.75;
    color: #111111;
  }

  .section-{{ section.id }}-about p,
  .section-{{ section.id }}-contact-copy p,
  .section-{{ section.id }}-policy p,
  .section-{{ section.id }}-policy li {
    margin: 0 0 1.8rem;
  }

  .section-{{ section.id }}-policy h2,
  .section-{{ section.id }}-policy h3 {
    margin: 3rem 0 1.2rem;
    font-family: Arial, sans-serif;
    font-size: 1.8rem;
    line-height: 1.4;
    color: #111111;
  }

  .section-{{ section.id }}-policy ul {
    margin: 0 0 2rem 2rem;
    padding: 0;
  }

  .section-{{ section.id }}-contact-layout {
    display: grid;
    gap: 3.2rem;
    align-items: start;
  }

  .section-{{ section.id }}-contact {
    margin-top: 0;
  }

  .section-{{ section.id }}-contact-email {
    color: #111111;
    text-decoration: none;
  }

  .section-{{ section.id }}-contact-team {
    margin-top: 2.4rem;
  }

  .section-{{ section.id }}-contact .contact__fields {
    display: grid;
    gap: 1.6rem;
  }

  .section-{{ section.id }}-contact .contact__button {
    margin-top: 2rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-contact-layout {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 5.6rem;
    }

    .section-{{ section.id }}-contact .contact__fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .section-{{ section.id }}-contact .field--full {
      grid-column: 1 / -1;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>

  {%- if is_about_page -%}
    <div class="section-{{ section.id }}-about rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <p>Moment is a brand that embodies doing what you would like to do - when you would like to do it.</p>
      <p>Our pieces don't come with structures or deadlines. There is no right time, no right place, no rules on how they should be worn. You can wear them for any occasion - because the occasion is whatever you decide it is.</p>
      <p>We don't believe clothing should tell you who to be. Every piece is a blank space waiting for your story, your timing, your way.</p>
      <p>You make the items.<br>Not the other way around.</p>
    </div>
    <div class="section-{{ section.id }}-signature{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      Moment
    </div>
  {%- elsif is_contact_page -%}
    <div class="section-{{ section.id }}-contact-layout">
      <div class="section-{{ section.id }}-contact-copy rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <p>We'd love to hear from you.</p>
        <p>If you have any questions - about your order, shipping, returns, or anything else - you can email us at:</p>
        <p><a class="section-{{ section.id }}-contact-email" href="mailto:info@momentwrld.com">info@momentwrld.com</a></p>
        <p>We aim to respond to all inquiries within 1-2 business days.</p>
        <p class="section-{{ section.id }}-contact-team">- The Moment Team</p>
      </div>

      <div class="section-{{ section.id }}-contact{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- form 'contact', id: 'ContactFormMainPage', class: 'contact isolate' -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
          {%- endif -%}

          <div class="contact__fields">
            <div class="field">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="ContactFormMainPage-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'templates.contact.form.name' | t }}"
              >
              <label class="field__label" for="ContactFormMainPage-name">{{ 'templates.contact.form.name' | t }}</label>
            </div>

            <div class="field field--with-error">
              <input
                autocomplete="email"
                type="email"
                id="ContactFormMainPage-email"
                class="field__input"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactFormMainPage-email-error"
                {% endif %}
                placeholder="{{ 'templates.contact.form.email' | t }}"
              >
              <label class="field__label" for="ContactFormMainPage-email">
                {{- 'templates.contact.form.email' | t }}
                <span aria-hidden="true">*</span>
              </label>
              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactFormMainPage-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                </small>
              {%- endif -%}
            </div>

            <div class="field">
              <input
                type="tel"
                id="ContactFormMainPage-phone"
                class="field__input"
                autocomplete="tel"
                name="contact[{{ 'templates.contact.form.phone' | t }}]"
                pattern="[0-9\-]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="{{ 'templates.contact.form.phone' | t }}"
              >
              <label class="field__label" for="ContactFormMainPage-phone">{{ 'templates.contact.form.phone' | t }}</label>
            </div>

            <div class="field field--full">
              <textarea
                rows="10"
                id="ContactFormMainPage-body"
                class="text-area field__input"
                name="contact[{{ 'templates.contact.form.comment' | t }}]"
                placeholder="{{ 'templates.contact.form.comment' | t }}"
              >{{- form.body -}}</textarea>
              <label class="form__label field__label" for="ContactFormMainPage-body">
                {{- 'templates.contact.form.comment' | t -}}
              </label>
            </div>
          </div>

          <div class="contact__button">
            <button type="submit" class="button">
              {{ 'templates.contact.form.send' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  {%- elsif is_shipping_page -%}
    <div class="section-{{ section.id }}-policy rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <p>Thank you for shopping with Moment.</p>
      <h2>Processing Time</h2>
      <p>All Moment products are premade and ready to ship. Please allow 24-48 hours for your order to be processed and shipped after purchase.</p>
      <p>Orders placed on weekends or holidays will begin processing on the next business day.</p>
      <h2>Shipping Carriers</h2>
      <p>All orders are shipped through UPS and DHL. Once your order ships, you will receive a confirmation email with your tracking number so you can follow your package every step of the way.</p>
      <h2>Delivery Times</h2>
      <p>Delivery times vary depending on your location and the carrier's service in your area. Please note that once your package is in the carrier's hands, delivery timelines are determined by UPS or DHL and may be affected by factors outside of our control, such as weather or carrier delays.</p>
      <h2>Incorrect Shipping Information</h2>
      <p>Please double-check your shipping address at checkout. Moment is not responsible for orders shipped to an incorrect address provided by the customer. If you notice an error in your address, contact us immediately at info@momentwrld.com and we will do our best to correct it before your order ships.</p>
      <h2>Lost or Stolen Packages</h2>
      <p>Moment is not responsible for packages that are lost or stolen after being marked as delivered by the carrier. If your package is lost in transit, please contact us at info@momentwrld.com and we will assist you in filing a claim with the carrier.</p>
      <h2>Questions</h2>
      <p>For any shipping-related questions, reach out to us at info@momentwrld.com.</p>
    </div>
  {%- elsif is_returns_page -%}
    <div class="section-{{ section.id }}-policy rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <p>At Moment, every product is carefully inspected before it ships. Because of the nature of our products, all sales are final.</p>
      <h2>No Refund Policy</h2>
      <p>We do not offer refunds, returns, or exchanges unless your item arrives defective or damaged.</p>
      <h2>Defective or Damaged Items</h2>
      <p>If you receive a defective or damaged item, please contact us at info@momentwrld.com within 7 days of delivery with the following:</p>
      <ul>
        <li>Your order number</li>
        <li>A description of the defect or damage</li>
        <li>Clear photos of the item and its packaging</li>
      </ul>
      <p>Once we review and approve your claim, we will offer a replacement or refund for the defective item. Claims submitted after 7 days of delivery may not be eligible.</p>
      <h2>Non-Qualifying Issues</h2>
      <p>The following do not qualify as defects:</p>
      <ul>
        <li>Minor variations in color due to screen settings</li>
        <li>Damage caused by wear, misuse, or improper care after delivery</li>
        <li>Change of mind or ordering the wrong item/size</li>
      </ul>
      <h2>Return Shipping</h2>
      <p>If a return is approved for a defective item, we will provide instructions on how and where to send your package. Items sent back without first requesting an approved return will not be accepted.</p>
      <h2>Questions</h2>
      <p>For any questions about your order, contact us at info@momentwrld.com.</p>
    </div>
  {%- elsif is_terms_page -%}
    <div class="section-{{ section.id }}-policy rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <p><strong>Last updated:</strong> July 2, 2026</p>
      <p>Welcome to Moment. These Terms of Service ("Terms") govern your use of our website, momentwrld.com (the "Site"), and any purchases you make through it. By accessing the Site or placing an order, you agree to these Terms. If you do not agree, please do not use the Site.</p>
      <h2>1. General</h2>
      <p>Moment ("we," "us," or "our") operates this Site to sell premade products directly to customers. We reserve the right to update or modify these Terms at any time without prior notice. Your continued use of the Site after changes are posted constitutes acceptance of the revised Terms.</p>
      <h2>2. Eligibility</h2>
      <p>By using this Site, you confirm that you are at least 18 years of age, or that you are using the Site under the supervision of a parent or legal guardian.</p>
      <h2>3. Products &amp; Availability</h2>
      <p>All products sold on this Site are premade. Product images are for illustration; slight variations in color or appearance may occur. We reserve the right to limit quantities, discontinue products, or refuse any order at our sole discretion.</p>
      <h2>4. Orders &amp; Payment</h2>
      <p>By placing an order, you agree to provide accurate, current, and complete purchase information. We reserve the right to cancel or refuse any order, including orders that appear fraudulent or unauthorized. Prices are subject to change without notice. Payment is due in full at the time of purchase.</p>
      <h2>5. Shipping</h2>
      <p>All products are premade and ship within 24-48 hours of order processing. Orders are shipped via UPS and DHL. Please see our Shipping Policy for full details.</p>
      <h2>6. Returns &amp; Refunds</h2>
      <p>All sales are final. We do not offer refunds unless your item arrives defective. Please see our Returns &amp; Refunds Policy for full details.</p>
      <h2>7. Intellectual Property</h2>
      <p>All content on this Site, including logos, designs, product images, graphics, and text, is the property of Moment and is protected by applicable copyright and trademark laws. You may not use, reproduce, or distribute any content without our prior written permission.</p>
      <h2>8. Prohibited Uses</h2>
      <p>You agree not to use the Site for any unlawful purpose, to solicit others to perform unlawful acts, to infringe on our intellectual property or that of others, to transmit viruses or malicious code, or to interfere with the security or operation of the Site.</p>
      <h2>9. Limitation of Liability</h2>
      <p>To the fullest extent permitted by law, Moment shall not be liable for any indirect, incidental, special, or consequential damages arising from your use of the Site or products purchased through it. Our total liability for any claim shall not exceed the amount you paid for the product in question.</p>
      <h2>10. Disclaimer</h2>
      <p>The Site and all products are provided "as is" and "as available" without warranties of any kind, express or implied, except as expressly stated in these Terms or required by law.</p>
      <h2>11. Indemnification</h2>
      <p>You agree to indemnify and hold harmless Moment and its owners, employees, and affiliates from any claim or demand arising out of your breach of these Terms or your violation of any law or third-party rights.</p>
      <h2>12. Governing Law</h2>
      <p>These Terms shall be governed by and construed in accordance with the laws of the jurisdiction in which Moment operates, without regard to conflict of law principles.</p>
      <h2>13. Contact</h2>
      <p>Questions about these Terms? Email us at info@momentwrld.com.</p>
    </div>
  {%- elsif is_privacy_page -%}
    <div class="section-{{ section.id }}-policy rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <p><strong>Last updated:</strong> July 2, 2026</p>
      <p>Moment ("we," "us," or "our") respects your privacy. This Privacy Policy explains how we collect, use, and protect your personal information when you visit momentwrld.com (the "Site") or make a purchase from us.</p>
      <h2>1. Information We Collect</h2>
      <p><strong>Information you provide:</strong> When you place an order or contact us, we collect information such as your name, email address, shipping address, billing address, and payment information.</p>
      <p><strong>Information collected automatically:</strong> When you browse the Site, we may automatically collect certain information about your device, including your IP address, browser type, time zone, and cookies installed on your device, as well as information about how you interact with the Site.</p>
      <h2>2. How We Use Your Information</h2>
      <p>We use your information to:</p>
      <ul>
        <li>Process and fulfill your orders, including shipping confirmations and tracking updates</li>
        <li>Communicate with you about your order or respond to inquiries</li>
        <li>Screen orders for potential risk or fraud</li>
        <li>Improve and optimize our Site and products</li>
        <li>Send you marketing communications, only if you have opted in (you may unsubscribe at any time)</li>
      </ul>
      <h2>3. Payment Information</h2>
      <p>Payments are processed by secure third-party payment processors. We do not store your full credit card or payment details on our servers.</p>
      <h2>4. Sharing Your Information</h2>
      <p>We do not sell your personal information. We share your information only with trusted third parties who help us operate our business, including payment processors, shipping carriers (UPS and DHL), and our website platform provider. We may also disclose information if required by law.</p>
      <h2>5. Cookies</h2>
      <p>We use cookies and similar technologies to keep your cart active, remember your preferences, and understand how visitors use our Site. You can disable cookies in your browser settings, though some Site features may not function properly.</p>
      <h2>6. Data Retention</h2>
      <p>We retain your order information for our records unless and until you ask us to delete it, subject to legal and tax record-keeping requirements.</p>
      <h2>7. Your Rights</h2>
      <p>Depending on your location, you may have the right to access, correct, or delete the personal information we hold about you, or to object to or restrict certain processing. To exercise these rights, contact us at info@momentwrld.com.</p>
      <h2>8. Children's Privacy</h2>
      <p>Our Site is not intended for individuals under the age of 18, and we do not knowingly collect personal information from children.</p>
      <h2>9. Security</h2>
      <p>We take reasonable measures to protect your personal information. However, no method of transmission over the internet is 100% secure, and we cannot guarantee absolute security.</p>
      <h2>10. Changes to This Policy</h2>
      <p>We may update this Privacy Policy from time to time. Changes will be posted on this page with an updated "Last updated" date.</p>
      <h2>11. Contact</h2>
      <p>For questions about this Privacy Policy or your personal data, email us at info@momentwrld.com.</p>
    </div>
  {%- else -%}
    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
